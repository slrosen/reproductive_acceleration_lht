@article{LeaRosenbaum2020,
   author = {Lea, Amanda J. and Rosenbaum, Stacy},
   title = {Understanding how early life effects evolve: progress, gaps, and future directions},
   journal = {Current Opinion in Behavioral Sciences},
   volume = {36},
   pages = {29-35},
   abstract = {Early life experiences have profound effects on later life health and on Darwinian fitness in many mammalian species, including humans. However, while it is clear that early life adversity often leads to compromised health, reproduction, and survival in adulthood, it is less clear why these links have evolved. Here, we review hypotheses from the evolutionary biology literature that have been proposed to explain how natural selection could produce early life environmental sensitivity. We evaluate competing hypotheses in light of their empirical support, and also discuss three emerging topics related to these evolutionary discussions. Specifically, we focus on: (i) whether different classes of early life effects evolve in different ways; (ii) how the existence of short, acute sensitive periods during development (e.g. gestation/pregnancy) informs evolutionary thinking about early life effects; and (iii) what to consider when using fitness proxies, including behavioral traits, to test evolutionary hypotheses. We conclude these discussions with suggestions for empirical work that could help resolve current debates about the causes, consequences, and adaptive significance of early life effects.},
   ISSN = {2352-1546},
   DOI = {10.1016/j.cobeha.2020.06.006},
   url = {https://www.sciencedirect.com/science/article/pii/S2352154620300942},
   year = {2020},
}

@article{Malanietal2023,
   author = {Malani, Anup and Archie, Elizabeth A. and Rosenbaum, Stacy},
   title = {Conceptual and analytical approaches for modelling the developmental origins of inequality},
   journal = {Philosophical Transactions of the Royal Society B: Biological Sciences},
   volume = {378},
   number = {1883},
   abstract = {In many species, individuals that experience harsh conditions during development have poor health and fitness outcomes in adulthood, compared with peers that do not. These early-life contributions to inequality are often attributed to two classes of evolutionary hypotheses: Developmental Constraints (DC) models, which focus on the deleterious effects of low-quality early-life environments, and Predictive Adaptive Response (PAR) hypotheses, which emphasize the costs individuals incur when they make incorrect predictions about conditions in adulthood. Testing these hypotheses empirically is difficult for conceptual and analytical reasons. Here, we help resolve some of these difficulties by providing mathematical definitions for DC, PAR (particularly focusing on ‘external’ PAR) and related concepts. We propose a novel, quadratic regression-based statistical test derived from these definitions. Our simulations show that this approach markedly improves the ability to discriminate between DC and PAR hypotheses relative to the status quo approach, which uses interaction effects. Simulated data indicate that the interaction effects approach often conflates PAR with DC, while the quadratic regression approach yields high sensitivity and specificity for detecting PAR. Our results highlight the value of linking verbal and visual models to a formal mathematical treatment for understanding the developmental origins of inequitable adult outcomes.This article is part of the theme issue ‘Evolutionary ecology of inequality’.},
   ISSN = {0962-8436},
   DOI = {10.1098/rstb.2022.0306},
   url = {https://doi.org/10.1098/rstb.2022.0306},
   year = {2023},
}

